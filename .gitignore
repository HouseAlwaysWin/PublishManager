# .NET build output (SDK-style: everything lands under bin/ and obj/).
# NOTE: do NOT add [Dd]ebug/ or [Rr]elease/ — those also match source folders
# named Debug/Release (e.g. src/PublishManager.Core/Release/).
bin/
obj/
*.user

# Rider / VS
.idea/
.vs/
*.suo

# Test / coverage
[Tt]est[Rr]esults/
*.coverage
coverage*.json

# OS
Thumbs.db
.DS_Store

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PublishManager.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="PublishManager.Views.WorkflowRunMonitorView"
             x:DataType="vm:WorkflowRunMonitorViewModel">

    <StackPanel Spacing="10">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding RunName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12" />
                    <TextBlock Text="{Binding Conclusion}" Opacity="0.7" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="80" Height="4"
                         VerticalAlignment="Center" Margin="8,0"
                         IsVisible="{Binding IsMonitoring}" />
            <Button Grid.Column="3" Content="在 GitHub 開啟" Click="OnOpenRunClick"
                    IsVisible="{Binding HtmlUrl, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </Grid>

        <!-- Jobs + steps timeline -->
        <ItemsControl ItemsSource="{Binding Jobs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:JobLineViewModel">
                    <Border Background="#0C808080" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Glyph}" FontSize="14" Width="16" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Steps}" Margin="24,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StepLineViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Glyph}" Width="16" Opacity="0.8" />
                                            <TextBlock Text="{Binding Name}" Opacity="0.85" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Logs (arrive per job on completion) -->
        <TextBox Text="{Binding LogText, Mode=OneWay}"
                 IsVisible="{Binding LogText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                 MaxHeight="240"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </StackPanel>
</UserControl>
